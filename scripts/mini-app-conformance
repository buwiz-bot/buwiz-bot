#!/bin/sh
# The Mini App Protocol v1 conformance run (drafts/rox-mini-app-protocol-v1.md,
# section 17), both sides: the broker's suite against the fixture plugin
# (`npm run conformance`) and Rox's host tests, named by spec ID. Prints
# each side's checklist and exits non-zero if either fails.
#
#   scripts/mini-app-conformance [broker dir]
#
# The broker dir defaults to this repo's server/; a grok-shell checkout
# (server/v1) still works. CARGO_TARGET_DIR is honoured: set it to keep the
# build out of app/target while Rox is running from there. TEST_PORT moves
# the broker's test port off a running one.
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BROKER="${1:-$ROOT/server}"
fail=0

echo "== broker ($BROKER)"
if [ -f "$BROKER/src/v1/plugins.mjs" ] || [ -f "$BROKER/server/v1/plugins.mjs" ]; then
  (cd "$BROKER" && npm run -s conformance) || fail=1
else
  echo "no broker v1 code in $BROKER (src/v1 or server/v1)"; fail=1
fi

echo "== Rox host"
out="$(cd "$ROOT/app" && CARGO_PROFILE_TEST_DEBUG=0 cargo test -q -p rox --lib -- --format terse 2>&1)" || fail=1
ids="$(cd "$ROOT/app" && cargo test -q -p rox --lib -- --list 2>/dev/null \
  | sed -n 's/^\(.*\): test$/\1/p' \
  | grep -oiE '(^|::)(man|app|brg|rsv|inv|agt|lcy|con)_[0-9]{2}[a-z0-9_]*' | sed 's/^:://' | sort -u)"
echo "$out" | grep -E '^test result|FAILED|panicked'
echo "Rox tests by spec 17 ID:"
echo "$ids" | awk -F_ 'NF { id = toupper($1) "-" $2; $1 = ""; $2 = ""; sub(/^ +/, ""); print "  " id "  " $0 }'
[ "$fail" = 0 ] && echo "conformance: pass" || echo "conformance: FAIL"
exit "$fail"
