#!/bin/bash
# A test Buwiz Bot: its own data dir, its own TMPDIR (so its dev hook file is its
# own), its own gpui-agent port and token, its window on AeroSpace
# workspace 3 (the owner's own Bot is on 4). A watcher lives as long as it does:
# if this Bot takes the front with no input just before it, that's a steal, and
# the workspace and window that had it get it back. Prints the pid; drive it
# with scripts/test-agent. Exits 1, the instance stopped, when AeroSpace
# never lists its window within 30 seconds.
#   scripts/buwiz-test [--name <name>] <app binary> <instance dir> <agent port> [VAR=value ...]
#   scripts/buwiz-test --bundle-only [--name <name>] <app binary> <instance dir>
#     (makes the test bundle below, prints its path, starts nothing)
# e.g. BUWIZ_BACKEND=http://127.0.0.1:8798 BUWIZ_HOST_TOKEN_FILE=<data>/host-token
# Start that broker with BUWIZ_BROKER_HUB=1 and --no-node, as the Bot does:
# without them Node answers in MOCK mode, replies are canned and
# /v1/host/tools gives a 405.
# Its clicks count as the person's. GPUI_AGENT_ACTOR=agent among the VAR=value
# arguments drives it as the AI instead.
# (scripts/test-rox is its old name.) Every variable it sets, and every
# ROX_<X>=value given, goes in by its Buwiz name and its old ROX_ one, so a
# binary built before the rename is a test instance too.
#
# It runs as a test bundle of its own, never as Buwiz Bot: the binary is
# copied into "<instance dir>/Buwiz Bot test-<name>.app" as
# Contents/MacOS/buwiz-bot-test-<name> (id dev.buwiz.bot.test-<name>, the
# icon with the orange TEST band, signed ad hoc) and started from there, so
# the Dock, the app switcher and the window say "Buwiz Bot test-<name>".
# <name> (letters, digits, -) defaults to the instance dir's name. The copy
# is refreshed when the binary changes.
set -e
NAME=""
ONLY=""
if [ "$1" = --bundle-only ]; then ONLY=1; shift; fi
if [ "$1" = --name ]; then NAME="$2"; shift 2; fi
BIN="$1"; R="$2"
if [ -n "$ONLY" ]; then shift 2; else PORT="$3"; shift 3; fi
mkdir -p "$R/data" "$R/tmp"
R="$(cd "$R" && pwd)"
if [ -z "$NAME" ]; then
  NAME="$(basename "$R" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | sed 's/^-*//; s/-*$//')"
fi
case "$NAME" in
  ""|*[!A-Za-z0-9-]*) echo "buwiz-test: the name must be letters, digits and -: '$NAME'" >&2; exit 2 ;;
esac
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TITLE="Buwiz Bot test-$NAME"
EXE="buwiz-bot-test-$NAME"
APP="$R/$TITLE.app"
VERSION="$(awk -F'"' '/^\[/{s=$0} s=="[package]" && /^version *=/{print $2; exit}' "$ROOT/app/Cargo.toml")"
STAMP="$(stat -f '%m %z %i' "$BIN") $BIN $NAME"
if [ ! -x "$APP/Contents/MacOS/$EXE" ] || [ "$(cat "$R/bundle-stamp" 2>/dev/null)" != "$STAMP" ]; then
  # from scratch: a copy over a binary keeps its old signature
  rm -rf "$APP"
  mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
  cp "$BIN" "$APP/Contents/MacOS/$EXE"
  cp "$ROOT/app/resources/AppIcon-test.icns" "$APP/Contents/Resources/AppIcon.icns"
  cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>dev.buwiz.bot.test-$NAME</string>
  <key>CFBundleName</key>
  <string>$TITLE</string>
  <key>CFBundleDisplayName</key>
  <string>$TITLE</string>
  <key>CFBundleExecutable</key>
  <string>$EXE</string>
  <key>CFBundleIconFile</key>
  <string>AppIcon</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleVersion</key>
  <string>$VERSION</string>
  <key>CFBundleShortVersionString</key>
  <string>$VERSION</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
PLIST
  codesign --force -s - "$APP" >/dev/null 2>&1 || { echo "buwiz-test: could not sign $APP" >&2; exit 1; }
  echo "$STAMP" > "$R/bundle-stamp"
fi
[ -n "$ONLY" ] && { echo "$APP"; exit 0; }
umask 077
# by the name the broker's sandbox keeps the Bot's shell from
head -c 32 /dev/urandom | base64 | tr -d '/+=' > "$R/buwiz-gpui-agent-token"
echo "127.0.0.1:$PORT" > "$R/addr"
# who the front belongs to, before this Bot could take it
front_app() { lsappinfo info -only bundleid "$(lsappinfo front)" 2>/dev/null | sed -n 's/.*="\(.*\)"$/\1/p'; }
# an app to give the front back to: a failed read or this Bot's last run is none
other_app() { [ -n "$1" ] && [ "$1" != "dev.buwiz.bot.test-$NAME" ]; }
focused_window() { aerospace list-windows --focused --format '%{window-id} %{app-pid}' 2>/dev/null; }
A=$(front_app)
other_app "$A" || A=""
WIN=$(focused_window | awk '{print $1}')
SPACE=$(aerospace list-workspaces --focused 2>/dev/null || true)
# VAR=value arguments by both names: ROX_<X> and BUWIZ_<X> alike
VARS=()
for a in "$@"; do
  case "$a" in
    ROX_*=*) VARS+=("BUWIZ_${a#ROX_}" "$a") ;;
    BUWIZ_*=*) VARS+=("$a" "ROX_${a#BUWIZ_}") ;;
    *) VARS+=("$a") ;;
  esac
done
# a test Bot names a broker or it won't start: with none given, one nobody runs
case " ${VARS[*]-} " in
  *" BUWIZ_BACKEND="*) ;;
  *) VARS+=("BUWIZ_BACKEND=http://127.0.0.1:1" "ROX_BACKEND=http://127.0.0.1:1") ;;
esac
env TMPDIR="$R/tmp/" BUWIZ_DATA_DIR="$R/data" ROX_DATA_DIR="$R/data" BUWIZ_BACKGROUND=1 ROX_BACKGROUND=1 \
  GPUI_AGENT=1 GPUI_AGENT_ALLOW_RELEASE=1 \
  GPUI_AGENT_ADDR="127.0.0.1:$PORT" GPUI_AGENT_TOKEN_FILE="$R/buwiz-gpui-agent-token" ${VARS[@]+"${VARS[@]}"} \
  nohup "$APP/Contents/MacOS/$EXE" > "$R/rox.log" 2>&1 < /dev/null &
P=$!
echo "$P" > "$R/pid"
# macOS can hand this Bot the front at any time, when the front app gives it up
# and this is the next app with a window, so the watch lasts as long as the Bot.
# Polling macOS costs little; AeroSpace is asked only when this Bot is in front.
front_pid() { lsappinfo info -only pid "$(lsappinfo front)" 2>/dev/null | sed -n 's/.*=//p'; }
# Whether the person touched the keyboard or mouse just now. The workspace can't
# tell a visit from a steal: AeroSpace follows an app macOS activates, so both
# end on workspace 3 within milliseconds. A visit comes from a key or a click.
# The limit: a steal while the person is typing or moving the mouse looks like a
# visit and stays. That's the worst moment for it, and this can't catch it.
input_just_now() {
  local idle
  idle="$(ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print $NF; exit}')"
  [ -n "$idle" ] && [ "$idle" -lt "${BUWIZ_TEST_VISIT_NS:-500000000}" ]
}
give_back() {
  [ -z "$3" ] || aerospace workspace "$3" 2>/dev/null || true
  # the exact window if it's still there, else its app, if it's still running
  if [ -n "$1" ] && aerospace focus --window-id "$1" 2>/dev/null; then
    return
  fi
  if [ -n "$2" ] && [ -n "$(lsappinfo find bundleid="$2" 2>/dev/null)" ]; then
    open -b "$2" 2>/dev/null || true
  fi
}
watch_front() {
  local was="$A" win="$WIN" space="$SPACE" pid now seen visit=
  while kill -0 "$P" 2>/dev/null; do
    pid="$(front_pid)"
    if [ "$pid" = "$P" ]; then
      # decided once, as it arrives: later input is the owner using what they came to
      if [ "$last" != "$P" ]; then
        visit=
        input_just_now && visit=1
      fi
      [ -n "$visit" ] || give_back "$win" "$was" "$space"
    elif [ "$pid" != "$last" ]; then
      # the front can change between these reads: never this Bot's own name
      now="$(front_app)"
      other_app "$now" && was="$now"
      seen="$(focused_window)"
      if [ "${seen#* }" != "$P" ]; then
        win="${seen%% *}"
        space="$(aerospace list-workspaces --focused 2>/dev/null || true)"
      fi
    fi
    last="$pid"
    sleep "${BUWIZ_TEST_TICK:-0.1}"
  done
}
last=""
watch_front </dev/null >/dev/null 2>&1 &
disown
for _ in $(seq 1 "${BUWIZ_TEST_LIST_TRIES:-120}"); do
  W=$(aerospace list-windows --all --format '%{window-id} %{app-pid}' 2>/dev/null | awk -v p="$P" '$2==p {print $1; exit}')
  [ -n "$W" ] && break
  sleep 0.25
done
# a window AeroSpace never lists stays where macOS put it, over every
# workspace: stop this instance (its own pid) rather than leave it there
if [ -z "$W" ]; then
  kill "$P" 2>/dev/null || true
  echo "pid $P: AeroSpace never listed its window; stopped" >&2
  exit 1
fi
aerospace move-node-to-workspace 3 --window-id "$W"
echo "pid $P window $W"
