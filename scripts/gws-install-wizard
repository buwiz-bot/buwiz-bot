#!/usr/bin/env bash
# Installs the Google Workspace plugin (app.buwiz.google-workspace), the
# buwiz-gws binary from buwiz-app/google-workspace, step by step; each step
# asks first.
#
#   1. builds buwiz-gws at the commit plugins/google-workspace/rev pins
#      (scripts/gws-build) and rox-broker (release, RUSTC_WRAPPER= empty);
#   2. signs the manifest with the publisher key gc-2026-01 from the login
#      Keychain (macOS asks you) into
#      plugins/google-workspace/manifest.signed.json;
#   3. bundles Buwiz Bot.app (app/bundle-dev.sh), which ships buwiz-gws and
#      that manifest in Contents/Resources/broker/bin/;
#   4. tells you what to type in Connect Apps to install the plugin.
#
# It reads no tokens, secrets or install records, and prints none: the
# plugin's current environment stays where it is, and step 4 says where.
#   ROX_APP=<dir>/Buwiz Bot.app  the bundle (default ~/Applications/Buwiz Bot.app)
#   CARGO_TARGET_DIR        honoured, as by bundle-dev.sh
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="${ROX_APP:-$HOME/Applications/Buwiz Bot.app}"
TARGET="${CARGO_TARGET_DIR:-$ROOT/broker/target}/release"
SIGNED="$ROOT/plugins/google-workspace/manifest.signed.json"
GWS="$APP/Contents/Resources/broker/bin/buwiz-gws"
KEY_ID=gc-2026-01

step() { printf '\n== %s\n' "$1"; }
ask() {
  local a
  read -r -p "$1 [y/N] " a
  [ "$a" = y ] || [ "$a" = Y ]
}

step "1/4 Build buwiz-gws (at plugins/google-workspace/rev) and rox-broker (release)"
if ask "Build now?"; then
  "$ROOT/scripts/gws-build" >/dev/null
  (cd "$ROOT/broker" && RUSTC_WRAPPER= cargo build --release -p rox-broker)
fi
BUILT="$("$ROOT/scripts/gws-build")"
[ -x "$BUILT" ] && [ -x "$TARGET/rox-broker" ] || { echo "no release build in $TARGET: build first" >&2; exit 1; }
echo "manifest version: $("$BUILT" manifest | sed -n 's/.*"version": *"\([^"]*\)".*/\1/p')"

step "2/4 Sign the manifest with $KEY_ID (you approve the Keychain prompt)"
echo "Writes $SIGNED. The key stays in the Keychain; nothing prints it."
if ask "Sign now?"; then
  UNSIGNED="$(mktemp -t buwiz-gws-manifest)"
  trap 'rm -f "$UNSIGNED"' EXIT
  "$BUILT" manifest > "$UNSIGNED"
  "$TARGET/rox-broker" sign-manifest "$UNSIGNED" --keychain "$KEY_ID" --out "$SIGNED"
fi
[ -f "$SIGNED" ] && grep -q '"signature"' "$SIGNED" || { echo "no signed manifest at $SIGNED: sign first" >&2; exit 1; }
echo "signed: $SIGNED"

step "3/4 Bundle $APP"
echo "Runs app/bundle-dev.sh with this build: buwiz-gws and its signed manifest go to $(dirname "$GWS")/."
echo "Quit Buwiz Bot first; it starts nothing."
if ask "Bundle now?"; then
  ROX_APP="$APP" BUWIZ_BROKER_BIN="$TARGET/rox-broker" BUWIZ_GWS_BIN="$BUILT" BUWIZ_GWS_MANIFEST="$SIGNED" "$ROOT/app/bundle-dev.sh"
fi
[ -x "$GWS" ] || { echo "no $GWS: bundle first" >&2; exit 1; }

step "4/4 Install the plugin in Connect Apps"
cat <<TEXT
Start Buwiz Bot, open Connect Apps → Add, and type one line: the environment
as VAR=value words, then the command and its argument. Quote a value or path
with spaces: "…" for the paths, '…' for GWS_UPSTREAM (compact JSON):

  GWS_MANIFEST="$GWS.manifest.json" GWS_UPSTREAM='<as now>' GWS_USER_EMAIL=<as now> "$GWS" mcp

GWS_UPSTREAM and GWS_USER_EMAIL keep the values the plugin runs with now.
They are in the broker's database, which this wizard does not open:
  <data dir>/generated/app.db, table v1_plugins, column env (a JSON
  object), row id 'app.buwiz.google-workspace', or
  'dev.goldcoders.google-workspace' for an install from before protocol 2.0
where <data dir> is the broker's (~/Library/Application Support/Grok Shell
on this Mac). They hold your OAuth client settings: copy them yourself,
and don't paste them into chats or logs. Pin the upstream while you are
there: in GWS_UPSTREAM's args, "workspace-mcp" becomes "workspace-mcp==2.2.1".

The review shows app.buwiz.google-workspace with two read-only tools,
gws_search_mail and gws_read_mail; approve it. An install from before
protocol 2.0 (dev.goldcoders.google-workspace) stays, failed: remove it
in Connect Apps once the new one works.
TEXT
