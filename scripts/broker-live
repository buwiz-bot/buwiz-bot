#!/bin/bash
# The live broker, in one command (Rust broker plan, 0.6).
#
#   scripts/broker-live status     health, who answers the port, plugins, last routine runs
#   scripts/broker-live backup     app.db (sqlite .backup), the bundle's server/ and
#                                  Buwiz Bot.app's broker/ (as rox-broker/) into
#                                  <data dir>/backups/<UTC time>/
#   scripts/broker-live start|stop|restart
#   scripts/broker-live use-node   the Node broker on the port (the rollback)
#   scripts/broker-live use-rust   rox-broker on the port, Node behind it (phase 1 on);
#                                  from phase 3 it hosts the v1 plugins and sessions
#                                  (ROX_BROKER_V1_HOST=0 leaves them to Node), from
#                                  phase 4 the MCP servers (ROX_BROKER_MCP_HOST=0
#                                  leaves them to Node)
#   scripts/broker-live use-rox    Buwiz Bot.app's own rox-broker (phase 7), started as Rox
#                                  starts it: hub, v1 and MCP hosts, no Node; Rox
#                                  then finds it answering
#   --port N (any position)        the same as PORT=N
#
# GS: the data dir (default ~/Library/Application Support/Grok Shell).
# RES: the app bundle's Resources dir holding server/ (default: the Grok
# Shell.app built in a grok-shell checkout beside this repo).
# ROX_APP: the Buwiz Bot.app use-rox starts from (default ~/Applications/Buwiz Bot.app).
# ROX_LOG: use-rox's log (default ~/Library/Logs/Buwiz Bot/broker.log, the app's).
# PORT: default 8787.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="${2:?--port takes a port}"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}
GS="${GS:-$HOME/Library/Application Support/Grok Shell}"
RES="${RES:-$ROOT/../grok-shell/dist/Grok Shell.app/Contents/Resources}"
ROX_APP="${ROX_APP:-$HOME/Applications/Buwiz Bot.app}"
RB="$ROX_APP/Contents/Resources/broker"
ROX_LOG="${ROX_LOG:-$HOME/Library/Logs/Buwiz Bot/broker.log}"
PORT="${PORT:-8787}"
URL="http://127.0.0.1:$PORT"
DB="$GS/generated/app.db"

listener() { lsof -t -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true; }
health() { curl -s -o /dev/null -w '%{http_code}' -m 5 "$URL/health" 2>/dev/null || true; }

wait_health() {
  for _ in $(seq 1 120); do
    [ "$(health)" = 200 ] && return 0
    sleep 0.5
  done
  echo "the broker did not answer on $PORT" >&2
  return 1
}

stop() {
  local pid
  pid=$(listener)
  [ -z "$pid" ] && { echo "nothing on $PORT"; return 0; }
  kill -TERM "$pid"
  for _ in $(seq 1 40); do
    [ -z "$(listener)" ] && { echo "stopped $pid"; return 0; }
    sleep 0.25
  done
  echo "$pid still holds $PORT" >&2
  return 1
}

# `exec`: the broker replaces the backgrounded subshell, which otherwise
# stays as its parent holding the caller's stdout (a pipe never closes).
start_node() {
  [ -n "$(listener)" ] && { echo "$PORT is taken by $(listener)" >&2; return 1; }
  [ -x "$RES/server/node" ] || { echo "no $RES/server/node (set RES)" >&2; return 1; }
  (cd /tmp && GROK_DATA_DIR="$GS" GROK_BUNDLE_ID=dev.goldcoders.grokshell NSH="$RES/server/nsh" \
    NSH_HOST="$RES/server/nsh-macos-host" NSH_CHUNK_DIR="$GS/chunks" PORT="$PORT" \
    exec nohup "$RES/server/node" "$RES/server/app-server.mjs" >>"$GS/server.log" 2>&1 </dev/null &)
  wait_health && echo "node broker on $PORT"
}

start_rust() {
  [ -n "$(listener)" ] && { echo "$PORT is taken by $(listener)" >&2; return 1; }
  [ -x "$RES/server/rox-broker" ] || { echo "no $RES/server/rox-broker yet (phase 1 packages it)" >&2; return 1; }
  (cd /tmp && GROK_DATA_DIR="$GS" GROK_BUNDLE_ID=dev.goldcoders.grokshell NSH="$RES/server/nsh" \
    NSH_HOST="$RES/server/nsh-macos-host" NSH_CHUNK_DIR="$GS/chunks" ROX_BROKER_V1_HOST="${ROX_BROKER_V1_HOST:-1}" \
    ROX_BROKER_MCP_HOST="${ROX_BROKER_MCP_HOST:-1}" \
    exec nohup "$RES/server/rox-broker" --port "$PORT" --data "$GS" --node "$RES/server/node" \
      --node-script "$RES/server/app-server.mjs" >>"$GS/server.log" 2>&1 </dev/null &)
  wait_health && echo "rox-broker on $PORT"
}

# What Buwiz Bot.app's broker needs; prints what is missing.
rox_missing() {
  local f
  for f in rox-broker bin/nsh bin/nsh-macos-host; do [ -x "$RB/$f" ] || echo "$RB/$f"; done
  [ -d "$RB/server" ] || echo "$RB/server"
}

# The same command line as Rox's own start (app/src/broker.rs launch()):
# the data dir's chunks, the bundle's nsh, without Rox's automation
# variables; cwd /, its own process group (Rox's start), stdin closed.
start_rox() {
  [ -n "$(listener)" ] && { echo "$PORT is taken by $(listener)" >&2; return 1; }
  [ -z "$(rox_missing)" ] || { echo "Buwiz Bot.app's broker is incomplete: $(rox_missing | tr '\n' ' ')" >&2; return 1; }
  mkdir -p "$(dirname "$ROX_LOG")" "$GS"
  (cd / && exec env -u GPUI_AGENT -u GPUI_AGENT_TOKEN -u GPUI_AGENT_ADDR -u GPUI_AGENT_ALLOW_RELEASE \
    -u PORT -u ROX_PUBLIC_PORT ROX_BROKER_HUB=1 ROX_BROKER_V1_HOST=1 ROX_BROKER_MCP_HOST=1 \
    GROK_DATA_DIR="$GS" NSH="$RB/bin/nsh" NSH_HOST="$RB/bin/nsh-macos-host" NSH_CHUNK_DIR="$GS/chunks" \
    nohup /usr/bin/perl -e 'setpgrp(0, 0); exec @ARGV or die "$ARGV[0]: $!\n"' \
    "$RB/rox-broker" --port "$PORT" --data "$GS" --assets "$RB/server" --no-node \
    >>"$ROX_LOG" 2>&1 </dev/null &)
  wait_health && echo "Buwiz Bot.app's rox-broker on $PORT (log $ROX_LOG)"
}

# Which broker holds the port: rox (Buwiz Bot.app's, no Node), rust (rox-broker
# with Node behind it), node, or none.
mode() {
  local pid cmd
  pid=$(listener)
  [ -z "$pid" ] && { echo none; return; }
  cmd=$(ps -o command= -p "$pid")
  case "$cmd" in
    *"/Contents/Resources/broker/rox-broker "*--no-node*) echo rox ;;
    *rox-broker*) echo rust ;;
    *node*) echo node ;;
    *) echo "other: $cmd" ;;
  esac
}

status() {
  local pid
  pid=$(listener)
  echo "health: $(health)"
  if [ -n "$pid" ]; then echo "port $PORT: pid $pid $(basename "$(ps -o comm= -p "$pid")")"; else echo "port $PORT: free"; fi
  echo "mode: $(mode)"
  if [ "$(mode)" = rox ]; then echo "binary: $(ps -o command= -p "$pid" | sed 's/ --port.*//')"; fi
  if [ -f "$GS/host-token" ] && [ -n "$pid" ]; then
    curl -s -m 5 -H "X-Buwiz-Host: $(cat "$GS/host-token")" "$URL/v1/host/plugins" \
      | python3 -c 'import json,sys
for p in json.load(sys.stdin).get("plugins", []): print("plugin:", p.get("id"), p.get("version"), p.get("state"), "on" if p.get("enabled") else "off")' 2>/dev/null || echo "plugins: unreadable"
  fi
  sqlite3 "file:$DB?mode=ro" "SELECT 'routine: ' || routine || ' ' || CASE enabled WHEN 1 THEN 'on' ELSE 'off' END || ' last run ' || coalesce(datetime(last_run/1000,'unixepoch','localtime'),'never') || coalesce(' error: ' || last_error, '') FROM v1_instances" 2>/dev/null || true
  # who runs each v1 plugin process: rox-broker (phase 3) or Node
  sqlite3 "file:$DB?mode=ro" "SELECT id, command FROM v1_plugins WHERE enabled=1" 2>/dev/null | while IFS='|' read -r id cmd; do
    local p parent
    p=$(pgrep -f -n "^$cmd" 2>/dev/null || true)
    parent=$([ -n "$p" ] && basename "$(ps -o comm= -p "$(ps -o ppid= -p "$p" | tr -d ' ')")" || echo none)
    echo "process: $id pid ${p:-none} under ${parent}"
  done
  # the MCP servers' status, and who runs the stdio ones: processes under
  # rox-broker (phase 4) or under Node
  if [ -n "$pid" ]; then
    curl -s -m 5 "$URL/mcp/servers" | python3 -c 'import json,sys
for s in json.load(sys.stdin).get("servers", []): print("mcp:", s.get("id"), s.get("status"))' 2>/dev/null || echo "mcp: unreadable"
    local node
    node=$(pgrep -P "$pid" -f "server/node" | head -1 || true)
    echo "children: rox-broker $(pgrep -P "$pid" | grep -vc "^${node:-x}$" || true), node $([ -n "$node" ] && pgrep -P "$node" | wc -l | tr -d ' ' || echo 0)"
  fi
  echo "keychain dialog: $(pgrep -q SecurityAgent && echo UP || echo none)"
}

backup() {
  local dir
  dir="$GS/backups/$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$dir"
  sqlite3 "$DB" ".backup '$dir/app.db'"
  if [ -d "$RES/server" ]; then cp -R "$RES/server" "$dir/server"; fi
  # use-rox's broker: rox-broker, its nsh and static files
  if [ -d "$RB" ]; then cp -R "$RB" "$dir/rox-broker"; fi
  echo "$dir"
}

case "${1:-}" in
  status) status ;;
  backup) backup ;;
  start) start_node ;;
  stop) stop ;;
  restart) stop && start_node ;;
  use-node) stop && start_node ;;
  use-rust)
    # nothing stops before there is a rox-broker to start
    [ -x "$RES/server/rox-broker" ] || { echo "no $RES/server/rox-broker yet (phase 1 packages it): nothing changed" >&2; exit 1; }
    stop && start_rust || { echo "rox-broker did not come up: back to node" >&2; stop || true; start_node; exit 1; } ;;
  use-rox)
    # nothing stops before Buwiz Bot.app's broker is complete
    [ -z "$(rox_missing)" ] || { echo "Buwiz Bot.app's broker is incomplete (run app/bundle-dev.sh): $(rox_missing | tr '\n' ' ')nothing changed" >&2; exit 1; }
    stop && start_rox || { echo "Buwiz Bot.app's rox-broker did not come up: back to node" >&2; stop || true; start_node; exit 1; } ;;
  *) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
