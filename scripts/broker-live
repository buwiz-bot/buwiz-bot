#!/bin/bash
# The live broker, in one command: Buwiz Bot.app's own buwiz-broker.
#
#   scripts/broker-live status     health, who answers the port, plugins, last routine runs
#   scripts/broker-live backup     app.db (sqlite .backup) and Buwiz Bot.app's broker/ (as
#                                  buwiz-broker/) into <data dir>/backups/<UTC time>/
#   scripts/broker-live stop       stop whatever broker holds the port
#   scripts/broker-live start      start Buwiz Bot.app's buwiz-broker, started as
#                                  Buwiz Bot starts it: hub, v1 and MCP hosts;
#                                  Buwiz Bot then finds it answering
#   scripts/broker-live restart|use-bundled   stop, then start (use-rox, the old name
#                                  of use-bundled, still works)
#   --port N (any position)        the same as PORT=N
#
# GS: the data dir (default ~/Library/Application Support/Buwiz Broker, or
# Grok Shell, its old name, while that one was not moved yet; a buwiz-broker
# from this repo moves it once, after a backup, when it starts on it and no
# other broker answers on 8787).
# BUWIZ_APP: the Buwiz Bot.app it starts from (default ~/Applications/Buwiz Bot.app).
# BUWIZ_LOG: its log (default ~/Library/Logs/Buwiz Bot/broker.log, the app's).
# (ROX_APP and ROX_LOG, the old names, still work.)
# PORT: default 8787.
# BUWIZ_HEALTH_TRIES: how many half-seconds to wait for the broker (default 120).
set -euo pipefail
# old_name NEW OLD: NEW takes OLD's value (with a warning) when only OLD is set
old_name() {
  if [ -z "${!1+x}" ] && [ -n "${!2+x}" ]; then
    echo "$2 is an old name; use $1" >&2
    printf -v "$1" '%s' "${!2}"
  fi
}
old_name BUWIZ_APP ROX_APP
old_name BUWIZ_LOG ROX_LOG
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --port) PORT="${2:?--port takes a port}"; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}
if [ -z "${GS:-}" ]; then
  GS="$HOME/Library/Application Support/Buwiz Broker"
  OLD_GS="$HOME/Library/Application Support/Grok Shell"
  if [ ! -e "$GS" ] && [ -d "$OLD_GS" ]; then GS="$OLD_GS"; fi
fi
BUWIZ_APP="${BUWIZ_APP:-$HOME/Applications/Buwiz Bot.app}"
RB="$BUWIZ_APP/Contents/Resources/broker"
# the broker by its name, else by its name before the rename
RB_BIN="$RB/buwiz-broker"
[ -x "$RB_BIN" ] || [ ! -x "$RB/rox-broker" ] || RB_BIN="$RB/rox-broker"
BUWIZ_LOG="${BUWIZ_LOG:-$HOME/Library/Logs/Buwiz Bot/broker.log}"
PORT="${PORT:-8787}"
URL="http://127.0.0.1:$PORT"
DB="$GS/generated/app.db"

listener() { lsof -t -nP -iTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -1 || true; }
health() { curl -s -o /dev/null -w '%{http_code}' -m 5 "$URL/health" 2>/dev/null || true; }

wait_health() {
  for _ in $(seq 1 "${BUWIZ_HEALTH_TRIES:-120}"); do
    [ "$(health)" = 200 ] && return 0
    sleep 0.5
  done
  echo "the broker did not answer on $PORT" >&2
  return 1
}

stop() {
  local pid
  pid=$(listener)
  [ -z "$pid" ] && { echo "nothing on $PORT"; return 0; }
  kill -TERM "$pid"
  for _ in $(seq 1 40); do
    [ -z "$(listener)" ] && { echo "stopped $pid"; return 0; }
    sleep 0.25
  done
  echo "$pid still holds $PORT" >&2
  return 1
}

# What Buwiz Bot.app's broker needs; prints what is missing.
rox_missing() {
  local f
  [ -x "$RB_BIN" ] || echo "$RB/buwiz-broker"
  for f in bin/nsh bin/nsh-macos-host; do [ -x "$RB/$f" ] || echo "$RB/$f"; done
  [ -d "$RB/server" ] || echo "$RB/server"
}

# The same command line as Rox's own start (app/src/broker.rs launch()):
# the data dir's chunks, the bundle's nsh, without Rox's automation
# variables; cwd /, its own process group (Rox's start), stdin closed.
start_rox() {
  local PIDFILE
  [ -n "$(listener)" ] && { echo "$PORT is taken by $(listener)" >&2; return 1; }
  [ -z "$(rox_missing)" ] || { echo "Buwiz Bot.app's broker is incomplete: $(rox_missing | tr '\n' ' ')" >&2; return 1; }
  mkdir -p "$(dirname "$BUWIZ_LOG")" "$GS"
  PIDFILE=$(mktemp "${TMPDIR:-/tmp}/broker-live-pid.XXXXXX")
  (cd / && exec env -u GPUI_AGENT -u GPUI_AGENT_TOKEN -u GPUI_AGENT_TOKEN_FILE -u GPUI_AGENT_ADDR -u GPUI_AGENT_ALLOW_RELEASE -u GPUI_AGENT_ACTOR \
    -u PORT -u BUWIZ_PUBLIC_PORT -u ROX_PUBLIC_PORT \
    BUWIZ_BROKER_DATA_DIR="$GS" GROK_DATA_DIR="$GS" NSH="$RB/bin/nsh" NSH_HOST="$RB/bin/nsh-macos-host" NSH_CHUNK_DIR="$GS/chunks" \
    nohup /usr/bin/perl -e 'setpgrp(0, 0); exec @ARGV or die "$ARGV[0]: $!\n"' \
    "$RB_BIN" --port "$PORT" --data "$GS" --assets "$RB/server" \
    >>"$BUWIZ_LOG" 2>&1 </dev/null &
    echo $! >"$PIDFILE")
  local started
  started=$(cat "$PIDFILE" 2>/dev/null || true)
  rm -f "$PIDFILE"
  if wait_health; then
    echo "Buwiz Bot.app's buwiz-broker on $PORT (log $BUWIZ_LOG)"
  else
    # stop what this call started (that pid only), so nothing holds the port
    if [ -n "$started" ] && kill -0 "$started" 2>/dev/null; then
      kill -TERM "$started" 2>/dev/null || true
      for _ in $(seq 1 40); do kill -0 "$started" 2>/dev/null || break; sleep 0.25; done
      kill -0 "$started" 2>/dev/null && kill -KILL "$started" 2>/dev/null || true
      echo "stopped the broker it started (pid $started)" >&2
    fi
    return 1
  fi
}

# Which broker holds the port: bundled (Buwiz Bot.app's), or none, or whatever else.
mode() {
  local pid cmd
  pid=$(listener)
  [ -z "$pid" ] && { echo none; return; }
  cmd=$(ps -o command= -p "$pid")
  case "$cmd" in
    *"/Contents/Resources/broker/buwiz-broker "* | *"/Contents/Resources/broker/rox-broker "*) echo bundled ;;
    *) echo "other: $cmd" ;;
  esac
}

status() {
  local pid
  pid=$(listener)
  echo "health: $(health)"
  if [ -n "$pid" ]; then echo "port $PORT: pid $pid $(basename "$(ps -o comm= -p "$pid")")"; else echo "port $PORT: free"; fi
  echo "mode: $(mode)"
  if [ "$(mode)" = bundled ]; then echo "binary: $(ps -o command= -p "$pid" | sed 's/ --port.*//')"; fi
  if [ -f "$GS/host-token" ] && [ -n "$pid" ]; then
    curl -s -m 5 -H "X-Buwiz-Host: $(cat "$GS/host-token")" "$URL/v1/host/plugins" \
      | python3 -c 'import json,sys
for p in json.load(sys.stdin).get("plugins", []): print("plugin:", p.get("id"), p.get("version"), p.get("state"), "on" if p.get("enabled") else "off")' 2>/dev/null || echo "plugins: unreadable"
  fi
  sqlite3 "file:$DB?mode=ro" "SELECT 'routine: ' || routine || ' ' || CASE enabled WHEN 1 THEN 'on' ELSE 'off' END || ' last run ' || coalesce(datetime(last_run/1000,'unixepoch','localtime'),'never') || coalesce(' error: ' || last_error, '') FROM v1_instances" 2>/dev/null || true
  # who runs each v1 plugin process
  sqlite3 "file:$DB?mode=ro" "SELECT id, command FROM v1_plugins WHERE enabled=1" 2>/dev/null | while IFS='|' read -r id cmd; do
    local p parent
    p=$(pgrep -f -n "^$cmd" 2>/dev/null || true)
    parent=$([ -n "$p" ] && basename "$(ps -o comm= -p "$(ps -o ppid= -p "$p" | tr -d ' ')")" || echo none)
    echo "process: $id pid ${p:-none} under ${parent}"
  done
  # the MCP servers' status
  if [ -n "$pid" ]; then
    curl -s -m 5 "$URL/mcp/servers" | python3 -c 'import json,sys
for s in json.load(sys.stdin).get("servers", []): print("mcp:", s.get("id"), s.get("status"))' 2>/dev/null || echo "mcp: unreadable"
    echo "children: $(pgrep -P "$pid" | wc -l | tr -d ' ')"
  fi
  echo "keychain dialog: $(pgrep -q SecurityAgent && echo UP || echo none)"
}

backup() {
  local dir
  dir="$GS/backups/$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$dir"
  sqlite3 "$DB" ".backup '$dir/app.db'"
  # the app's broker: buwiz-broker, its nsh and static files
  if [ -d "$RB" ]; then cp -R "$RB" "$dir/buwiz-broker"; fi
  echo "$dir"
}

case "${1:-}" in
  status) status ;;
  backup) backup ;;
  stop) stop ;;
  start|restart|use-bundled|use-rox)
    [ "$1" = use-rox ] && echo "broker-live use-rox is an old name; use use-bundled" >&2
    # nothing stops before Buwiz Bot.app's broker is complete
    [ -z "$(rox_missing)" ] || { echo "Buwiz Bot.app's broker is incomplete (run app/bundle-dev.sh): $(rox_missing | tr '\n' ' ')nothing changed" >&2; exit 1; }
    if [ "$1" != start ]; then stop; fi
    start_rox || { echo "Buwiz Bot.app's buwiz-broker did not come up on $PORT" >&2; exit 1; } ;;
  *) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
