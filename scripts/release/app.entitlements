<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime's exceptions for the app's executable and buwiz-broker
  (scripts/release/sign.sh; docs/release.md says why each one is or isn't
  here). Everything else in the bundle is signed with none.

  automation.apple-events: the broker runs osascript for Reminders, Finder
  and the save-as picker (hub/routes/leftovers.rs, bots.rs, popout.rs).
  Under the hardened runtime, Apple Events the app's processes cause are
  refused without it, and TCC asks the user with the app's
  NSAppleEventsUsageDescription.

  Not here, on purpose: allow-jit and allow-unsigned-executable-memory (no
  in-process JIT: QuickJS is the interpreter, WKWebView's JIT runs in
  WebKit's own processes, and the bundled broker runs with no Node);
  disable-library-validation (no dylibs outside the system's are loaded).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
