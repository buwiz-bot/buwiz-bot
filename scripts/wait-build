#!/bin/bash
# One heavy build at a time across agents and sessions: waits while a hold
# file exists, then takes a mutex (a directory) for the command's run.
#   scripts/wait-build cargo build -p rox
# ROX_BUILD_LOCK / ROX_BUILD_HOLD move the mutex and the hold file.
LOCK=${ROX_BUILD_LOCK:-${TMPDIR:-/tmp}/rox-build.mutex}
HOLD=${ROX_BUILD_HOLD:-${TMPDIR:-/tmp}/rox-build.hold}
while true; do
  if [ -e "$HOLD" ]; then sleep 30; continue; fi
  if mkdir "$LOCK" 2>/dev/null; then break; fi
  owner=$(cat "$LOCK/pid" 2>/dev/null)
  if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then rm -rf "$LOCK"; continue; fi
  sleep 15
done
echo $$ > "$LOCK/pid"
trap 'rm -rf "$LOCK"' EXIT
"$@"
