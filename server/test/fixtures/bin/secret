#!/usr/bin/env node
// secret stub for the broker tests, so no test reads the Keychain: `secret
// get <NAME>` prints $SECRET_STUB_<NAME> when set, else fails as an unknown
// key does (the broker then goes without it).
// BUWIZ_STUB_LOG: each call appends {bin, argv} as a JSON line there.
const { appendFileSync } = require("node:fs");
const STUB_LOG = require("../../../src/env.mjs").env("BUWIZ_STUB_LOG");

const argv = process.argv.slice(2);

if (STUB_LOG) appendFileSync(STUB_LOG, JSON.stringify({ bin: "secret", argv }) + "\n");
const v = argv[0] === "get" ? process.env[`SECRET_STUB_${argv[1]}`] : undefined;

if (v === undefined) {
  process.stderr.write(`secret: no ${argv[1] || "key"}\n`);
  process.exit(1);
}

process.stdout.write(`${v}\n`);
