#!/usr/bin/env node
// osascript stub for the broker tests: runs no script and shows no dialog.
// What it answers (a picker's chosen paths, one per line; a JXA script's
// JSON), first match wins:
//   OSASCRIPT_STUB_FILE: a file whose text is printed, read at each call so
//     a test can change it while the broker runs; the text "!cancel" exits
//     1 as a cancelled dialog does; a missing file prints nothing.
//   OSASCRIPT_STUB_FAIL=1: exits 1 as a cancelled dialog does.
//   OSASCRIPT_STUB_OUT: printed as is. Default: nothing.
// BUWIZ_STUB_LOG: each call appends {bin, argv} as a JSON line there, plus
// {env} with the REM_* variables (the arguments JXA scripts read) when any
// is set.
const { appendFileSync, existsSync, readFileSync } = require("node:fs");
const STUB_LOG = require("../../../src/env.mjs").env("BUWIZ_STUB_LOG");

const rem = Object.fromEntries(Object.entries(process.env).filter(([k]) => k.startsWith("REM_")).sort(([a], [b]) => (a < b ? -1 : 1)));
const call = { bin: "osascript", argv: process.argv.slice(2), ...(Object.keys(rem).length ? { env: rem } : {}) };

if (STUB_LOG) appendFileSync(STUB_LOG, JSON.stringify(call) + "\n");
const file = process.env.OSASCRIPT_STUB_FILE;
const out = file ? (existsSync(file) ? readFileSync(file, "utf8") : "") : process.env.OSASCRIPT_STUB_OUT || "";

if (out === "!cancel" || (!file && process.env.OSASCRIPT_STUB_FAIL === "1")) {
  process.stderr.write("execution error: User canceled. (-128)\n");
  process.exit(1);
}

process.stdout.write(out);
